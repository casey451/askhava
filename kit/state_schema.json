          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "attempt",
                "model",
                "model_evidence_count",
                "head_sha",
                "pr",
                "checks",
                "reviewer_model",
                "path_check_ok",
                "started_at",
                "ended_at",
                "result"
              ],
              "properties": {
                "attempt": {
                  "type": "integer"
                },
                "model": {
                  "type": "string"
                },
                "model_evidence_count": {
                  "type": "integer"
                },
                "head_sha": {
                  "type": "string"
                },
                "pr": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "checks": {
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "reviewer_model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "path_check_ok": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "started_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ended_at": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                }
              }
            }
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "lane": {
            "type": "string",
            "pattern": "^([1-9][0-9]*|fix)$"
          },
          "resync": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "attempt",
              "from",
              "paths",
              "at"
            ]
          },
          "resyncs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "attempt",
                "from",
                "paths",
                "at"
              ]
            }
          },
          "update_merges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "how",
                "at"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "how": {
                  "type": "string",
                  "enum": [
                    "runner",
                    "adopted"
                  ]
                },
                "at": {
                  "type": "string"
                }
              }
            }
          },
          "plan_gap_strikes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "paths",
                "attempt"
              ],
              "properties": {
                "at": {
                  "type": "string"
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "attempt": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "lanes_fallback": {
      "type": [
        "object",
        "null"
