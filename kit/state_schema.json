              ],
              "properties": {
                "start": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tokens": {
                  "type": "integer"
                }
              }
            },
            "week": {
              "type": "object",
              "required": [
                "start",
                "tokens"
              ],
              "properties": {
                "start": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tokens": {
                  "type": "integer"
                }
              }
