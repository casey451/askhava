  "query": "SELECT m.id, m.mailbox_id, m.cards_and_quotes, m.confirm_and_billing FROM businesses.emergency_switch s JOIN businesses.team_member m ON m.id = s.member_id AND m.business_id = s.business_id JOIN businesses.business b ON b.id = s.business_id WHERE s.business_id = $1 AND s.switch_on AND m.removed_at IS NULL AND b.after_hours AND b.after_hours_suspended_at IS NULL ORDER BY m.is_owner DESC, m.id",
