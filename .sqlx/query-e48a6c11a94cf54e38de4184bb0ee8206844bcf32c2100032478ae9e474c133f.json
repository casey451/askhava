{
  "db_name": "PostgreSQL",
  "query": "WITH due AS (SELECT id FROM messaging.email_outbox WHERE ((status = 'queued' AND not_before <= $1 AND (claimed_at IS NULL OR claimed_at <= $2)) OR (status = 'sending' AND (claimed_at <= $2 OR (claimed_at IS NULL AND not_before <= $2)))) AND template_id <> ALL($3) AND (template_id <> ALL($4) OR waiting_for IS NOT NULL) ORDER BY not_before, queued_at, id LIMIT $5 FOR UPDATE SKIP LOCKED) UPDATE messaging.email_outbox o SET status = 'sending', claimed_at = $1, first_unsure_at = CASE WHEN o.status = 'sending' THEN COALESCE(o.first_unsure_at, o.claimed_at, o.not_before) ELSE o.first_unsure_at END FROM due WHERE o.id = due.id RETURNING o.id, o.template_id, o.recipient_id, o.recipient_kind, o.subject_ids, o.queued_at, o.first_unsure_at, (strpos(o.subject || o.html || o.plain, $6) > 0 OR strpos(o.subject || o.html || o.plain, $7) > 0) AS \"marked!\" ",
