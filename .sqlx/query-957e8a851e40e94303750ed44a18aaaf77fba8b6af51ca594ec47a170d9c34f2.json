{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, e.kind, w.waived_cents AS \"waived_cents?\" FROM payments.ledger_entry e\n           LEFT JOIN payments.free_win w ON w.ledger_entry_id = e.id\n          WHERE e.business_id = $1 AND e.job_id = $2\n            AND e.kind IN ('charge', 'free-first-win', 'repeat-customer', 'fee-free-job-type')\n          ORDER BY e.seq LIMIT 1",
