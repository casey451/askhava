  "db_name": "PostgreSQL",
  "query": "WITH old AS (SELECT id, body FROM messaging.outbox WHERE id = $1 AND status = 'sending' AND ($2::timestamptz IS NULL OR sending_since IS NULL OR sending_since < $2) FOR UPDATE) UPDATE messaging.outbox o SET status = 'unknown', body = NULL FROM old WHERE o.id = old.id RETURNING o.recipient_id, o.recipient_kind, o.template_id, o.subject_ids, old.body AS \"body!\"",
