  "query": "WITH old AS (SELECT id, body FROM messaging.outbox WHERE id = $1 AND status IN ('queued', 'sending') FOR UPDATE) UPDATE messaging.outbox o SET status = 'failed', body = NULL FROM old WHERE o.id = old.id RETURNING o.recipient_id, o.recipient_kind, o.template_id, o.subject_ids, old.body AS \"body!\"",
