  "query": "SELECT f.trip_fee, f.parts, f.permit, f.may_change, f.spanish, q.earliest_visit::text AS visit, q.visit_part FROM quotes.quote_facts f JOIN quotes.quote q USING (job_id, business_id) WHERE f.business_id = $1 AND f.job_type = $2 AND q.earliest_visit IS NOT NULL AND q.visit_part IS NOT NULL ORDER BY f.recorded_at DESC, f.job_id DESC LIMIT 1",
