  "query": "UPDATE core.task SET lease_owner = $1, lease_until = $2, attempts = attempts + 1 WHERE id IN (SELECT id FROM core.task WHERE done_at IS NULL AND dead_at IS NULL AND run_at <= $3 AND attempts < max_attempts AND (lease_until IS NULL OR lease_until < $3) ORDER BY run_at, id LIMIT $4 FOR UPDATE SKIP LOCKED) RETURNING id, kind, payload, attempts",
