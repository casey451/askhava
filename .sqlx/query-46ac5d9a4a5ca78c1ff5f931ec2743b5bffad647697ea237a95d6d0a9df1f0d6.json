{
  "db_name": "PostgreSQL",
  "query": "SELECT c.job_id, c.sent_at, s.category, s.town FROM quotes.job_card c JOIN LATERAL (SELECT category, town FROM quotes.shown_card s WHERE s.job_id = c.job_id AND s.sent_at IS NOT NULL ORDER BY s.sent_at, s.id LIMIT 1) s ON true WHERE c.business_id = $1 AND c.sent_at > $2 AND NOT EXISTS ( SELECT 1 FROM quotes.quote q WHERE q.job_id = c.job_id AND q.business_id = c.business_id AND q.withdrawn_at IS NULL) ORDER BY c.sent_at, c.job_id",
