{
  "name": "askhava-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Ask Hava TypeScript tooling: tsc --strict, eslint and Playwright for e2e and accessibility (D-453); never in the production image",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --ignoreConfig --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --target ES2022 --module ES2022 --lib ES2022,DOM app/*/static/*.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
